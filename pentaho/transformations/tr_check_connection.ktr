<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info><name>tr_check_connection</name><description>Fail fast when PostgreSQL is unavailable</description><extended_description/><trans_version/>
    <trans_type>Normal</trans_type><directory>/unsw</directory><parameters/><log/><maxdate/><size_rowset>1000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty><sleep_time_full>50</sleep_time_full><unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown><feedback_size>1000</feedback_size><using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/><capture_step_performance>N</capture_step_performance>
  </info>
  <connection>
    <name>unsw_dw_postgres</name><server>localhost</server><type>POSTGRESQL</type><access>Native</access>
    <database>unsw_dw</database><port>5432</port><username>unsw</username><password>unsw_password</password>
    <servername/><data_tablespace/><index_tablespace/>
    <attributes>
      <attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute>
    </attributes>
  </connection>
  <step>
    <name>Check PostgreSQL</name><type>ExecSQL</type><description>Connection smoke test</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method></partitioning>
    <connection>unsw_dw_postgres</connection><execute_each_row>N</execute_each_row><single_statement>Y</single_statement>
    <replace_variables>Y</replace_variables><quoteString>N</quoteString><sql>SELECT 1;</sql>
    <set_params>N</set_params><insert_field/><update_field/><delete_field/><read_field/><cluster_schema/>
    <GUI><xloc>300</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <order/><notepads/><step_error_handling/><slave-step-copy-partition-distribution/>
  <slave_transformation>N</slave_transformation>
</transformation>
